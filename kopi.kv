                canvas.before:
                    Color:
                        rgba: 0.16, 0.12, 0.09, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]

                Label:
                    id: riwayat_text
                    markup: True
                    text: 'Belum ada transaksi'
                    font_size: '12sp'
                    color: 0.95, 0.90, 0.85, 1
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1] + 20

        SecondaryBtn:
            text: 'Kembali ke Beranda'
            size_hint_y: None
            height: '45dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'beranda'


# =========================================================
# 14. NOTIFIKASI SCREEN
# =========================================================

<NotifikasiScreen>:
    name: 'notifikasi'

    BoxLayout:
        orientation: 'vertical'
        padding: [22, 25, 22, 20]
        spacing: 14

        Label:
            text: 'Pemberitahuan & Promo'
            font_size: '20sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '30dp'
            halign: 'left'
            text_size: self.size

        # Card Promo 1
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '85dp'
            padding: 12
            spacing: 4
            canvas.before:
                Color:
                    rgba: 0.18, 0.13, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]

            Label:
                text: '[PROMO] Diskon 20% Take Away Aktif'
                font_size: '14sp'
                bold: True
                color: 0.83, 0.61, 0.36, 1
                halign: 'left'
                text_size: self.size

            Label:
                text: 'Gunakan layanan Take Away dan nikmati potongan harga langsung tanpa kode promo.'
                font_size: '11sp'
                color: 0.76, 0.71, 0.63, 1
                halign: 'left'
                text_size: self.size

        # Card Promo 2
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '85dp'
            padding: 12
            spacing: 4
            canvas.before:
                Color:
                    rgba: 0.18, 0.13, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]

            Label:
                text: '[MEMBER] Kopi Gratis Loyalty'
                font_size: '14sp'
                bold: True
                color: 0.52, 0.82, 0.60, 1
                halign: 'left'
                text_size: self.size

            Label:
                text: 'Kumpulkan 10 stamp untuk menukarkan 1 cup Kopi Susu Gula Aren gratis.'
                font_size: '11sp'
                color: 0.76, 0.71, 0.63, 1
                halign: 'left'
                text_size: self.size

        Widget:

        SecondaryBtn:
            text: 'Kembali ke Beranda'
            size_hint_y: None
            height: '45dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'beranda'


# =========================================================
# 15. AKUN SCREEN
# =========================================================

<AkunScreen>:
    name: 'akun'

    BoxLayout:
        orientation: 'vertical'
        padding: [22, 25, 22, 20]
        spacing: 12

        Label:
            text: 'Profil Akun Saya'
            font_size: '20sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '30dp'

        # Profil Card
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '90dp'
            padding: 14
            spacing: 4
            canvas.before:
                Color:
                    rgba: 0.18, 0.13, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            Label:
                id: akun_info
                markup: True
                text: 'Nama Pengguna'
                font_size: '14sp'
                color: 0.98, 0.95, 0.90, 1
                halign: 'left'
                text_size: self.size

        # Loyalty Card
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '110dp'
            padding: 14
            spacing: 4
            canvas.before:
                Color:
                    rgba: 0.22, 0.16, 0.12, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            Label:
                id: loyalty_info
                markup: True
                text: 'Poin & Stamp'
                font_size: '12sp'
                color: 0.83, 0.61, 0.36, 1
                halign: 'left'
                text_size: self.size

        Widget:

        OutlineBtn:
            text: 'Keluar Akun (Logout)'
            size_hint_y: None
            height: '45dp'
            on_release: root.do_logout()

        SecondaryBtn:
            text: 'Kembali ke Beranda'
            size_hint_y: None
            height: '45dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'beranda'