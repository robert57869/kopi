#:kivy 2.0.0

# =========================================================
# GAYA & WIDGET REUSABLE
# =========================================================

<Screen>:
    canvas.before:
        Color:
            rgba: 0.11, 0.09, 0.07, 1
        Rectangle:
            pos: self.pos
            size: self.size

<PrimaryBtn@Button>:
    background_color: 0, 0, 0, 0
    color: 0.12, 0.08, 0.05, 1
    bold: True
    font_size: '15sp'
    canvas.before:
        Color:
            rgba: (0.83, 0.61, 0.36, 1) if self.state == 'normal' else (0.70, 0.50, 0.28, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

<SecondaryBtn@Button>:
    background_color: 0, 0, 0, 0
    color: 0.95, 0.90, 0.85, 1
    font_size: '14sp'
    canvas.before:
        Color:
            rgba: (0.22, 0.16, 0.12, 1) if self.state == 'normal' else (0.30, 0.22, 0.17, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

<OutlineBtn@Button>:
    background_color: 0, 0, 0, 0
    color: 0.83, 0.61, 0.36, 1
    font_size: '14sp'
    canvas.before:
        Color:
            rgba: 0.83, 0.61, 0.36, 0.9
        Line:
            width: 1.2
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)

<ModernInput@TextInput>:
    background_normal: ''
    background_active: ''
    background_color: 0.18, 0.14, 0.11, 1
    foreground_color: 0.98, 0.96, 0.94, 1
    hint_text_color: 0.60, 0.52, 0.45, 1
    cursor_color: 0.83, 0.61, 0.36, 1
    padding: [14, 12, 14, 12]
    font_size: '14sp'

# =========================================================
# SCREEN MANAGER
# =========================================================

<MyScreenManager>:
    SplashScreen:
    WelcomeScreen:
    LoginScreen:
    RegisterScreen:
    BerandaScreen:
    LayananScreen:
    MenuScreen:
    DetailProdukScreen:
    KeranjangScreen:
    KonfirmasiScreen:
    PembayaranScreen:
    PesananBerhasilScreen:
    RiwayatScreen:
    NotifikasiScreen:
    AkunScreen:

# =========================================================
# 1. SPLASH SCREEN
# =========================================================

<SplashScreen>:
    name: 'splash'

    BoxLayout:
        orientation: 'vertical'
        padding: [30, 50, 30, 40]
        spacing: 20

        Widget:
            size_hint_y: 0.1

        Image:
            source: app.logo_path
            size_hint: None, None
            size: '170dp', '170dp'
            pos_hint: {'center_x': 0.5}
            allow_stretch: True
            keep_ratio: True

        Label:
            text: 'KOPI NUSANTARA'
            font_size: '26sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '35dp'

        Label:
            text: 'Cita Rasa Kopi Asli Indonesia\nSegar, Autentik & Berkualitas'
            font_size: '13sp'
            halign: 'center'
            color: 0.76, 0.71, 0.63, 1
            size_hint_y: None
            height: '40dp'

        Widget:
            size_hint_y: 0.2

        PrimaryBtn:
            text: 'Mulai Pesan Kopi'
            size_hint_y: None
            height: '50dp'
            on_release:
                root.manager.transition.direction = 'left'
                root.manager.current = 'welcome'


# =========================================================
# 2. WELCOME SCREEN
# =========================================================

<WelcomeScreen>:
    name: 'welcome'

    BoxLayout:
        orientation: 'vertical'
        padding: [25, 40, 25, 30]
        spacing: 15

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '110dp'
            spacing: 6

            Label:
                text: 'Selamat Datang!'
                font_size: '24sp'
                bold: True
                color: 0.98, 0.95, 0.90, 1
                halign: 'left'
                text_size: self.size

            Label:
                text: 'Nikmati kemudahan pesan langsung dari meja atau bawa pulang dengan promo spesial.'
                font_size: '13sp'
                color: 0.76, 0.71, 0.63, 1
                halign: 'left'
                text_size: self.size

        # Card Banner
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '130dp'
            padding: 16
            spacing: 8
            canvas.before:
                Color:
                    rgba: 0.18, 0.13, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            Label:
                text: '[ PROMO HARI INI ]'
                font_size: '15sp'
                bold: True
                color: 0.83, 0.61, 0.36, 1
                halign: 'left'
                text_size: self.size

            Label:
                text: 'Diskon 20% tanpa batas minimal khusus pesanan Take Away!\nKumpulkan Stamp untuk Kopi Gratis.'
                font_size: '12sp'
                color: 0.88, 0.84, 0.78, 1
                halign: 'left'
                text_size: self.size

        Widget:

        PrimaryBtn:
            text: 'Masuk ke Akun'
            size_hint_y: None
            height: '48dp'
            on_release:
                root.manager.transition.direction = 'left'
                root.manager.current = 'login'

        SecondaryBtn:
            text: 'Daftar Akun Baru'
            size_hint_y: None
            height: '48dp'
            on_release:
                root.manager.transition.direction = 'left'
                root.manager.current = 'register'

        OutlineBtn:
            text: 'Lanjut sebagai Tamu (Guest) >>'
            size_hint_y: None
            height: '44dp'
            on_release: root.lanjut_sebagai_tamu()


# =========================================================
# 3. LOGIN SCREEN
# =========================================================

<LoginScreen>:
    name: 'login'

    BoxLayout:
        orientation: 'vertical'
        padding: [25, 30, 25, 20]
        spacing: 12

        Label:
            text: 'Masuk Akun'
            font_size: '22sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '35dp'
            halign: 'left'
            text_size: self.size

        Label:
            text: 'Masukkan Email atau No. WhatsApp Anda'
            font_size: '13sp'
            color: 0.76, 0.71, 0.63, 1
            size_hint_y: None
            height: '25dp'
            halign: 'left'
            text_size: self.size

        Widget:
            size_hint_y: None
            height: '10dp'

        ModernInput:
            id: email_input
            hint_text: 'Email / Nomor HP (contoh: 081234567890)'
            multiline: False
            size_hint_y: None
            height: '45dp'

        BoxLayout:
            size_hint_y: None
            height: '45dp'
            spacing: 6

            ModernInput:
                id: password_input
                hint_text: 'Kata Sandi / PIN'
                password: True
                multiline: False

            Button:
                id: btn_eye_login
                text: '👁'
                font_name: 'EmojiFont'
                size_hint_x: None
                width: '45dp'
                background_color: 0, 0, 0, 0
                color: 0.83, 0.61, 0.36, 1
                font_size: '18sp'
                canvas.before:
                    Color:
                        rgba: 0.22, 0.16, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.toggle_password()

        Label:
            id: error_label
            text: ''
            color: 1, 0.4, 0.4, 1
            font_size: '12sp'
            size_hint_y: None
            height: '25dp'

        Widget:

        PrimaryBtn:
            text: 'Masuk Sekarang'
            size_hint_y: None
            height: '48dp'
            on_release: root.do_login()

        SecondaryBtn:
            text: 'Kembali'
            size_hint_y: None
            height: '44dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'welcome'


# =========================================================
# 4. REGISTER SCREEN
# =========================================================

<RegisterScreen>:
    name: 'register'

    BoxLayout:
        orientation: 'vertical'
        padding: [25, 25, 25, 18]
        spacing: 10

        Label:
            text: 'Daftar Akun Baru'
            font_size: '22sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '32dp'
            halign: 'left'
            text_size: self.size

        Label:
            text: 'Daftar untuk mengumpulkan stamp & promo loyalitas'
            font_size: '12sp'
            color: 0.76, 0.71, 0.63, 1
            size_hint_y: None
            height: '18dp'
            halign: 'left'
            text_size: self.size

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 10

                ModernInput:
                    id: reg_nama
                    hint_text: 'Nama Lengkap'
                    multiline: False
                    size_hint_y: None
                    height: '44dp'

                ModernInput:
                    id: reg_email
                    hint_text: 'Alamat Email (contoh: user@gmail.com)'
                    multiline: False
                    size_hint_y: None
                    height: '44dp'

                ModernInput:
                    id: reg_hp
                    hint_text: 'Nomor WhatsApp / HP (diawali 08...)'
                    multiline: False
                    size_hint_y: None
                    height: '44dp'

                BoxLayout:
                    size_hint_y: None
                    height: '44dp'
                    spacing: 6

                    ModernInput:
                        id: reg_password
                        hint_text: 'Buat Kata Sandi (Minimal 4 karakter)'
                        password: True
                        multiline: False

                    Button:
                        id: btn_eye_reg1
                        text: '👁'
                        font_name: 'EmojiFont'
                        size_hint_x: None
                        width: '44dp'
                        background_color: 0, 0, 0, 0
                        color: 0.83, 0.61, 0.36, 1
                        font_size: '18sp'
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        on_release: root.toggle_reg_password()

                BoxLayout:
                    size_hint_y: None
                    height: '44dp'
                    spacing: 6

                    ModernInput:
                        id: reg_password_confirm
                        hint_text: 'Ulangi Kata Sandi'
                        password: True
                        multiline: False

                    Button:
                        id: btn_eye_reg2
                        text: '👁'
                        font_name: 'EmojiFont'
                        size_hint_x: None
                        width: '44dp'
                        background_color: 0, 0, 0, 0
                        color: 0.83, 0.61, 0.36, 1
                        font_size: '18sp'
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        on_release: root.toggle_reg_confirm_password()

                Label:
                    id: reg_error
                    text: ''
                    color: 1, 0.4, 0.4, 1
                    font_size: '12sp'
                    size_hint_y: None
                    height: '24dp'

        PrimaryBtn:
            text: 'Daftar Akun Sekarang'
            size_hint_y: None
            height: '48dp'
            on_release: root.do_register()

        SecondaryBtn:
            text: 'Sudah Punya Akun? Masuk'
            size_hint_y: None
            height: '42dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'login'


# =========================================================
# 5. BERANDA SCREEN
# =========================================================

<BerandaScreen>:
    name: 'beranda'

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 20, 20, 15]
        spacing: 12

        # Header Bar
        BoxLayout:
            size_hint_y: None
            height: '50dp'
            spacing: 10

            BoxLayout:
                orientation: 'vertical'
                Label:
                    id: welcome_msg
                    text: 'Hai, Pelanggan'
                    font_size: '18sp'
                    bold: True
                    color: 0.98, 0.95, 0.90, 1
                    halign: 'left'
                    text_size: self.size

                Label:
                    id: points_info
                    text: 'Poin: 120 | Stamp: 7/10'
                    font_size: '12sp'
                    color: 0.83, 0.61, 0.36, 1
                    halign: 'left'
                    text_size: self.size

            Button:
                id: cart_badge
                text: 'Keranjang (0)'
                size_hint: None, None
                size: '115dp', '38dp'
                background_color: 0, 0, 0, 0
                color: 0.12, 0.08, 0.05, 1
                bold: True
                font_size: '12sp'
                canvas.before:
                    Color:
                        rgba: 0.83, 0.61, 0.36, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.open_keranjang()

        # Banner Card
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '80dp'
            padding: 12
            spacing: 4
            canvas.before:
                Color:
                    rgba: 0.20, 0.14, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]

            Label:
                text: '[ SPESIAL TAKE AWAY: DISKON 20% ]'
                bold: True
                font_size: '13sp'
                color: 0.83, 0.61, 0.36, 1
                halign: 'left'
                text_size: self.size

            Label:
                text: 'Pesan sekarang & ambil langsung tanpa antre di kasir!'
                font_size: '11sp'
                color: 0.85, 0.80, 0.74, 1
                halign: 'left'
                text_size: self.size

        # Tombol Pesan Utama
        PrimaryBtn:
            text: 'Pesan Kopi Sekarang'
            size_hint_y: None
            height: '48dp'
            on_release: root.ke_layanan()

        # Label Rekomendasi
        Label:
            text: 'Menu Favorit Barista'
            font_size: '15sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '25dp'
            halign: 'left'
            text_size: self.size

        # Grid Shortcut Menu
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 10

                # Card Kopi Aren
                BoxLayout:
                    size_hint_y: None
                    height: '75dp'
                    padding: 8
                    spacing: 10
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.13, 0.10, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                    Image:
                        source: 'kopiaren.png'
                        size_hint: None, None
                        size: '60dp', '60dp'
                        allow_stretch: True

                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Kopi Susu Gula Aren'
                            bold: True
                            font_size: '14sp'
                            color: 0.98, 0.95, 0.90, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Rp 23.000 - Signature Best Seller'
                            font_size: '12sp'
                            color: 0.83, 0.61, 0.36, 1
                            halign: 'left'
                            text_size: self.size

                    Button:
                        text: 'Pilih'
                        size_hint: None, None
                        size: '65dp', '35dp'
                        pos_hint: {'center_y': 0.5}
                        background_color: 0, 0, 0, 0
                        color: 0.12, 0.08, 0.05, 1
                        bold: True
                        canvas.before:
                            Color:
                                rgba: 0.83, 0.61, 0.36, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.buka_menu_langsung('Kopi Susu Gula Aren', 23000, 'kopiaren.png')

                # Card Cappuccino
                BoxLayout:
                    size_hint_y: None
                    height: '75dp'
                    padding: 8
                    spacing: 10
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.13, 0.10, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                    Image:
                        source: 'cappuccino.png'
                        size_hint: None, None
                        size: '60dp', '60dp'
                        allow_stretch: True

                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Cappuccino'
                            bold: True
                            font_size: '14sp'
                            color: 0.98, 0.95, 0.90, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Rp 25.000 - Busa Susu Lembut'
                            font_size: '12sp'
                            color: 0.83, 0.61, 0.36, 1
                            halign: 'left'
                            text_size: self.size

                    Button:
                        text: 'Pilih'
                        size_hint: None, None
                        size: '65dp', '35dp'
                        pos_hint: {'center_y': 0.5}
                        background_color: 0, 0, 0, 0
                        color: 0.12, 0.08, 0.05, 1
                        bold: True
                        canvas.before:
                            Color:
                                rgba: 0.83, 0.61, 0.36, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.buka_menu_langsung('Cappuccino', 25000, 'cappuccino.png')

        # Bottom Bar Menu
        BoxLayout:
            size_hint_y: None
            height: '45dp'
            spacing: 8

            SecondaryBtn:
                text: 'Riwayat'
                on_release:
                    root.manager.transition.direction = 'left'
                    root.manager.get_screen('riwayat').setup_view()
                    root.manager.current = 'riwayat'

            SecondaryBtn:
                text: 'Promo'
                on_release:
                    root.manager.transition.direction = 'left'
                    root.manager.current = 'notifikasi'

            SecondaryBtn:
                text: 'Akun'
                on_release:
                    root.manager.transition.direction = 'left'
                    root.manager.current = 'akun'


# =========================================================
# 6. LAYANAN SCREEN
# =========================================================

<LayananScreen>:
    name: 'layanan'

    BoxLayout:
        orientation: 'vertical'
        padding: [25, 30, 25, 20]
        spacing: 16

        Label:
            text: 'Pilih Metode Pemesanan'
            font_size: '22sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '30dp'

        Label:
            text: 'Bagaimana Anda ingin menikmati kopi hari ini?'
            font_size: '13sp'
            color: 0.76, 0.71, 0.63, 1
            size_hint_y: None
            height: '20dp'

        Widget:
            size_hint_y: None
            height: '15dp'

        # Card Dine In
        Button:
            size_hint_y: None
            height: '95dp'
            background_color: 0, 0, 0, 0
            canvas.before:
                Color:
                    rgba: (0.22, 0.16, 0.12, 1) if self.state == 'normal' else (0.30, 0.22, 0.17, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]
            on_release: root.pilih('Dine In')

            BoxLayout:
                pos: self.parent.pos
                size: self.parent.size
                padding: 18
                spacing: 15

                Label:
                    text: '[MEJA]'
                    bold: True
                    font_size: '14sp'
                    color: 0.83, 0.61, 0.36, 1
                    size_hint_x: None
                    width: '60dp'

                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: 'Dine In (Makan di Tempat)'
                        font_size: '16sp'
                        bold: True
                        color: 0.98, 0.95, 0.90, 1
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'Pesan nyaman dari meja Anda, barista antar langsung.'
                        font_size: '12sp'
                        color: 0.76, 0.71, 0.63, 1
                        halign: 'left'
                        text_size: self.size

        # Card Take Away
        Button:
            size_hint_y: None
            height: '95dp'
            background_color: 0, 0, 0, 0
            canvas.before:
                Color:
                    rgba: (0.26, 0.18, 0.12, 1) if self.state == 'normal' else (0.35, 0.25, 0.18, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]
            on_release: root.pilih('Take Away')

            BoxLayout:
                pos: self.parent.pos
                size: self.parent.size
                padding: 18
                spacing: 15

                Label:
                    text: '[-20%]'
                    bold: True
                    font_size: '14sp'
                    color: 0.83, 0.61, 0.36, 1
                    size_hint_x: None
                    width: '60dp'

                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: 'Take Away (Diskon 20%)'
                        font_size: '16sp'
                        bold: True
                        color: 0.83, 0.61, 0.36, 1
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'Bawa pulang tanpa antre. Hemat diskon 20% langsung!'
                        font_size: '12sp'
                        color: 0.85, 0.80, 0.74, 1
                        halign: 'left'
                        text_size: self.size

        Widget:

        SecondaryBtn:
            text: 'Kembali ke Beranda'
            size_hint_y: None
            height: '45dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'beranda'


# =========================================================
# 7. MENU SCREEN
# =========================================================

<MenuScreen>:
    name: 'menu'

    BoxLayout:
        orientation: 'vertical'
        padding: [18, 20, 18, 15]
        spacing: 10

        # Header
        BoxLayout:
            size_hint_y: None
            height: '35dp'
            Label:
                id: menu_title
                text: 'Daftar Menu Kopi'
                font_size: '20sp'
                bold: True
                color: 0.98, 0.95, 0.90, 1
                halign: 'left'
                text_size: self.size

        # Promo Tag
        Label:
            id: promo_badge
            text: 'Racikan Kopi Nusantara Terbaik'
            font_size: '12sp'
            color: 0.83, 0.61, 0.36, 1
            size_hint_y: None
            height: '22dp'
            halign: 'left'
            text_size: self.size

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 12

                # Item 1: Cappuccino
                BoxLayout:
                    size_hint_y: None
                    height: '90dp'
                    padding: 8
                    spacing: 12
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.13, 0.10, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12]

                    Image:
                        source: 'cappuccino.png'
                        size_hint: None, None
                        size: '74dp', '74dp'
                        allow_stretch: True
                        keep_ratio: True

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: 2
                        Label:
                            text: 'Cappuccino'
                            bold: True
                            font_size: '15sp'
                            color: 0.98, 0.95, 0.90, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Espresso dengan foam susu tebal'
                            font_size: '11sp'
                            color: 0.70, 0.65, 0.58, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Rp 25.000'
                            bold: True
                            font_size: '13sp'
                            color: 0.83, 0.61, 0.36, 1
                            halign: 'left'
                            text_size: self.size

                    Button:
                        text: '+ Pesan'
                        size_hint: None, None
                        size: '70dp', '36dp'
                        pos_hint: {'center_y': 0.5}
                        background_color: 0, 0, 0, 0
                        color: 0.12, 0.08, 0.05, 1
                        bold: True
                        canvas.before:
                            Color:
                                rgba: 0.83, 0.61, 0.36, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.pilih_menu('Cappuccino', 25000, 'cappuccino.png')

                # Item 2: Americano
                BoxLayout:
                    size_hint_y: None
                    height: '90dp'
                    padding: 8
                    spacing: 12
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.13, 0.10, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12]

                    Image:
                        source: 'americano.png'
                        size_hint: None, None
                        size: '74dp', '74dp'
                        allow_stretch: True
                        keep_ratio: True

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: 2
                        Label:
                            text: 'Americano'
                            bold: True
                            font_size: '15sp'
                            color: 0.98, 0.95, 0.90, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Espresso hitam murni & segar'
                            font_size: '11sp'
                            color: 0.70, 0.65, 0.58, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Rp 20.000'
                            bold: True
                            font_size: '13sp'
                            color: 0.83, 0.61, 0.36, 1
                            halign: 'left'
                            text_size: self.size

                    Button:
                        text: '+ Pesan'
                        size_hint: None, None
                        size: '70dp', '36dp'
                        pos_hint: {'center_y': 0.5}
                        background_color: 0, 0, 0, 0
                        color: 0.12, 0.08, 0.05, 1
                        bold: True
                        canvas.before:
                            Color:
                                rgba: 0.83, 0.61, 0.36, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.pilih_menu('Americano', 20000, 'americano.png')

                # Item 3: Kopi Susu Gula Aren
                BoxLayout:
                    size_hint_y: None
                    height: '90dp'
                    padding: 8
                    spacing: 12
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.13, 0.10, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12]

                    Image:
                        source: 'kopiaren.png'
                        size_hint: None, None
                        size: '74dp', '74dp'
                        allow_stretch: True
                        keep_ratio: True

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: 2
                        Label:
                            text: 'Kopi Susu Gula Aren'
                            bold: True
                            font_size: '15sp'
                            color: 0.98, 0.95, 0.90, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Creamy susu gurih & manis aren asli'
                            font_size: '11sp'
                            color: 0.70, 0.65, 0.58, 1
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: 'Rp 23.000'
                            bold: True
                            font_size: '13sp'
                            color: 0.83, 0.61, 0.36, 1
                            halign: 'left'
                            text_size: self.size

                    Button:
                        text: '+ Pesan'
                        size_hint: None, None
                        size: '70dp', '36dp'
                        pos_hint: {'center_y': 0.5}
                        background_color: 0, 0, 0, 0
                        color: 0.12, 0.08, 0.05, 1
                        bold: True
                        canvas.before:
                            Color:
                                rgba: 0.83, 0.61, 0.36, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.pilih_menu('Kopi Susu Gula Aren', 23000, 'kopiaren.png')

        # Action Button
        BoxLayout:
            size_hint_y: None
            height: '45dp'
            spacing: 10

            SecondaryBtn:
                text: '< Ubah Layanan'
                size_hint_x: 0.4
                on_release:
                    root.manager.transition.direction = 'right'
                    root.manager.current = 'layanan'

            PrimaryBtn:
                text: 'Lihat Keranjang'
                size_hint_x: 0.6
                on_release:
                    root.manager.transition.direction = 'left'
                    root.manager.get_screen('keranjang').update_view()
                    root.manager.current = 'keranjang'


# =========================================================
# 8. DETAIL PRODUK SCREEN
# =========================================================

<DetailProdukScreen>:
    name: 'detail'

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 15, 20, 15]
        spacing: 10

        # Header Image Box
        BoxLayout:
            size_hint_y: None
            height: '160dp'
            padding: 5
            canvas.before:
                Color:
                    rgba: 0.16, 0.12, 0.09, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            Image:
                id: detail_image
                source: ''
                allow_stretch: True
                keep_ratio: True

        Label:
            id: detail_title
            text: 'Detail Produk'
            font_size: '20sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '28dp'

        # Scrollable Customizations
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 10

                # Ukuran
                Label:
                    text: 'Ukuran Cup:'
                    font_size: '13sp'
                    bold: True
                    color: 0.83, 0.61, 0.36, 1
                    size_hint_y: None
                    height: '20dp'
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: '38dp'
                    spacing: 8
                    Button:
                        id: btn_ukuran_s
                        markup: True
                        font_name: 'EmojiFont'
                        text: 'S'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_ukuran('S')

                    Button:
                        id: btn_ukuran_m
                        markup: True
                        font_name: 'EmojiFont'
                        text: '[b]M ✓[/b]'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_ukuran('M')

                    Button:
                        id: btn_ukuran_l
                        markup: True
                        font_name: 'EmojiFont'
                        text: 'L (+4k)'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_ukuran('L')

                # Tingkat Manis (Sugar)
                Label:
                    text: 'Tingkat Manis (Sugar Level):'
                    font_size: '13sp'
                    bold: True
                    color: 0.83, 0.61, 0.36, 1
                    size_hint_y: None
                    height: '20dp'
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: '38dp'
                    spacing: 8
                    Button:
                        id: btn_gula_normal
                        markup: True
                        font_name: 'EmojiFont'
                        text: '[b]Normal ✓[/b]'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_gula('Normal')

                    Button:
                        id: btn_gula_less
                        markup: True
                        font_name: 'EmojiFont'
                        text: 'Less 50%'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_gula('Less')

                    Button:
                        id: btn_gula_no
                        markup: True
                        font_name: 'EmojiFont'
                        text: '0% Gula'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_gula('No')

                # Es (Ice)
                Label:
                    text: 'Tingkat Es / Suhu:'
                    font_size: '13sp'
                    bold: True
                    color: 0.83, 0.61, 0.36, 1
                    size_hint_y: None
                    height: '20dp'
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: '38dp'
                    spacing: 8
                    Button:
                        id: btn_es_normal
                        markup: True
                        font_name: 'EmojiFont'
                        text: '[b]Normal ✓[/b]'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_es('Normal')

                    Button:
                        id: btn_es_less
                        markup: True
                        font_name: 'EmojiFont'
                        text: 'Less Ice'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_es('Less')

                    Button:
                        id: btn_es_hot
                        markup: True
                        font_name: 'EmojiFont'
                        text: 'Hangat (Hot)'
                        background_color: 0, 0, 0, 0
                        color: 0.95, 0.90, 0.85, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.set_es('Hot')

                # Quantity Selector
                BoxLayout:
                    size_hint_y: None
                    height: '42dp'
                    spacing: 12
                    padding: [0, 5, 0, 0]

                    Label:
                        text: 'Jumlah Pesanan:'
                        font_size: '13sp'
                        bold: True
                        color: 0.98, 0.95, 0.90, 1
                        halign: 'left'
                        text_size: self.size

                    Button:
                        text: '-'
                        size_hint: None, None
                        size: '36dp', '36dp'
                        font_size: '18sp'
                        bold: True
                        background_color: 0, 0, 0, 0
                        color: 0.83, 0.61, 0.36, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.ubah_qty(-1)

                    Label:
                        id: qty_label
                        text: '1'
                        bold: True
                        font_size: '16sp'
                        color: 0.98, 0.95, 0.90, 1
                        size_hint_x: None
                        width: '30dp'

                    Button:
                        text: '+'
                        size_hint: None, None
                        size: '36dp', '36dp'
                        font_size: '18sp'
                        bold: True
                        background_color: 0, 0, 0, 0
                        color: 0.83, 0.61, 0.36, 1
                        canvas.before:
                            Color:
                                rgba: 0.22, 0.16, 0.12, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        on_release: root.ubah_qty(1)

        # Action Buttons
        PrimaryBtn:
            id: detail_price_btn
            text: 'Tambah ke Keranjang - Rp 25.000'
            size_hint_y: None
            height: '48dp'
            on_release: root.tambah_ke_keranjang()

        SecondaryBtn:
            text: 'Batal'
            size_hint_y: None
            height: '40dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'menu'


# =========================================================
# 9. KERANJANG SCREEN
# =========================================================

<KeranjangScreen>:
    name: 'keranjang'

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 20, 20, 15]
        spacing: 10

        Label:
            text: 'Keranjang Pesanan'
            font_size: '20sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '30dp'
            halign: 'left'
            text_size: self.size

        # Box Daftar Pesanan
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: 10
                canvas.before:
                    Color:
                        rgba: 0.16, 0.12, 0.09, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]

                Label:
                    id: isi_keranjang
                    markup: True
                    text: 'Keranjang kosong'
                    color: 0.95, 0.90, 0.85, 1
                    font_size: '13sp'
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1] + 15

        # Ringkasan Biaya Box
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '85dp'
            padding: 10
            canvas.before:
                Color:
                    rgba: 0.20, 0.15, 0.11, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

            Label:
                id: ringkasan_biaya
                markup: True
                text: 'Subtotal: Rp 0\nTotal Bayar: Rp 0'
                font_size: '12sp'
                color: 0.95, 0.90, 0.85, 1
                halign: 'left'
                text_size: self.size

        # Action Buttons
        PrimaryBtn:
            id: btn_checkout
            text: 'Lanjut ke Konfirmasi >>'
            size_hint_y: None
            height: '48dp'
            on_release: root.lanjut_konfirmasi()

        BoxLayout:
            size_hint_y: None
            height: '38dp'
            spacing: 8

            OutlineBtn:
                text: '- Hapus Terakhir'
                on_release: root.hapus_item_terakhir()

            OutlineBtn:
                text: 'Kosongkan'
                on_release: root.kosongkan()

        SecondaryBtn:
            text: 'Tambah Menu Lain'
            size_hint_y: None
            height: '40dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'menu'


# =========================================================
# 10. KONFIRMASI SCREEN
# =========================================================

<KonfirmasiScreen>:
    name: 'konfirmasi'

    BoxLayout:
        orientation: 'vertical'
        padding: [22, 25, 22, 18]
        spacing: 12

        Label:
            text: 'Konfirmasi Pesanan'
            font_size: '22sp'
            bold: True
            color: 0.98, 0.95, 0.90, 1
            size_hint_y: None
            height: '30dp'

        Label:
            id: konfirmasi_layanan
            markup: True
            text: 'Tipe Layanan: Dine In'
            font_size: '14sp'
            color: 0.83, 0.61, 0.36, 1
            size_hint_y: None
            height: '22dp'

        ModernInput:
            id: input_meja
            hint_text: 'Nomor Meja (contoh: Meja 05)'
            multiline: False
            size_hint_y: None
            height: '46dp'

        ModernInput:
            id: input_catatan
            hint_text: 'Catatan Barista (misal: Sedotan terpisah, cup double)'
            multiline: False
            size_hint_y: None
            height: '46dp'

        # Ringkasan Total Box
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '90dp'
            padding: 14
            spacing: 4
            canvas.before:
                Color:
                    rgba: 0.18, 0.13, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]

            Label:
                id: ringkasan_text
                markup: True
                text: 'Total Tagihan'
                font_size: '13sp'
                color: 0.95, 0.90, 0.85, 1
                halign: 'left'
                text_size: self.size

        Widget:

        PrimaryBtn:
            text: 'Lanjut Pembayaran >>'
            size_hint_y: None
            height: '48dp'
            on_release: root.lanjut_pembayaran()

        SecondaryBtn:
            text: 'Kembali ke Keranjang'
            size_hint_y: None
            height: '42dp'
            on_release:
                root.manager.transition.direction = 'right'
                root.manager.current = 'keranjang'


